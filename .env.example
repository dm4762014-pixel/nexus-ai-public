# Copy to .env; start.ps1 loads NEXUS_ values only. Never commit real secrets/data.
NEXUS_MODEL=qwen3:1.7b
NEXUS_CONTEXT=2048
NEXUS_MODEL_TIMEOUT=120
NEXUS_MODEL_THREADS=4
NEXUS_MODEL_BATCH=64
NEXUS_TASK_TIMEOUT=300
NEXUS_BROWSER=0
NEXUS_SECURE_COOKIES=0
NEXUS_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional absolute location; default is D:\nexus-ai\data
# NEXUS_DATA_DIR=D:\nexus-ai\data
